kernel-panic.mooo.com {
    # 1. Keycloak Auth & Static Resources
    handle /realms/* {
        reverse_proxy keycloak_server:8080
    }
    handle /resources/* {
        reverse_proxy keycloak_server:8080
    }

    # 2. Go API & Streaming (SSE / WebSockets)
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy host.docker.internal:8080 {
            # Disable buffering so SSE events stream instantly to the client
            flush_interval -1
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}