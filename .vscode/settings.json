{
    "protobuf.externalLinter.enabled": true,
    "protobuf.externalLinter.linter": "buf",
    "protobuf.externalLinter.bufPath": "/opt/homebrew/bin/buf",
    "search.useIgnoreFiles": true,
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/*.pb.go": true,
        "**/backend/gen/**": true,
        "**/backend/internal/docs/**": true
    }
}